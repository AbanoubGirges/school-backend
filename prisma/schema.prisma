// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // @ts-ignore
  url      = env("DIRECT_URL")
}

// user model
enum Gender {
  MALE
  FEMALE
}

enum Role {
  SUDO
  ADMIN
  USER
  FATHER
}

enum Status {
  PENDING
  REJECTED
  APPROVED
}

model User {
  id                String              @id @default(uuid())
  userName          String              @unique
  password          String
  name              String
  gender            Gender
  birthdate         DateTime
  address           String
  role              Role
  whatsapp          String
  phoneNumber       String              @unique
  homeNumber        String?
  schoolName        String
  educationType     String
  educationYear     String
  confessionFather  String
  liturgyDate       String
  servantPrepYear   String
  serviceType       String
  registerDate      DateTime            @default(now())
  status            Status              @default(PENDING)
  attendances       Attendance[]
  spiritualNotes    SpiritualNote[]
  pushNotifications PushNotification?
  results           Result[]
  attempts          AssignmentAttempt[]
  allNotifications  AllNotifications[]
  resetPassword      ResetPassword?
}
//needs reset password
model ResetPassword {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
}

//attendance model
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSEDLATE
  UNEXCUSEDLATE
}

model Attendance {
  id     String           @id @default(uuid())
  userId String
  date   DateTime         @default(now())
  status AttendanceStatus
  user   User             @relation(fields: [userId], references: [id])
  note   String?
  term   Term             @relation(fields: [termId], references: [id])
  termId String

  @@unique([userId, date])
}

//lectures model
model Lecture {
  id      String   @id @default(uuid())
  title   String
  type    String
  date    DateTime
  path    String   @unique
  subject Subject
}

//subjects enum
enum Subject {
  BIBLE
  SERVICE_TOPICS
  DOCTRINE
  CHURCH_HISTORY
  RITUALS
  HYMNS
}

//spiritual notes model
model SpiritualNote {
  userId     String
  submission SpiritualNoteSubmission
  date       DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id])

  @@id([userId, date, submission])
}

enum SpiritualNoteSubmission {
  MORNINGPRAYER
  NOONPRAYER
  NIGHTPRAYER
  LITURGY
  BIBLE
  CONFESSION
}

//notification model
model PushNotification {
  id        String @id @default(cuid())
  userId    String @unique
  expoToken String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

//failed notification
model FailedNotification {
  id            String   @id @default(cuid())
  expoPushToken String
  title         String
  body          String
  data          Json?
  createdAt     DateTime @default(now())
}

//results model
model Result {
  id      String        @id @default(cuid())
  userId  String
  subject ResultSubject
  score   Float
  date    DateTime      @default(now())
  user    User          @relation(fields: [userId], references: [id])
  term    Term          @relation(fields: [termId], references: [id])
  termId  String
  @@unique([subject,termId,userId])
}

enum ResultSubject {
  BIBLE
  SERVICE_TOPICS
  DOCTRINE
  CHURCH_HISTORY
  RITUALS
  HYMNS
  MEMORIZATION_TEXTS
  ATTENDANCE_GRADE
  SPIRITUAL_NOTES
}

model Term {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  results     Result[]
  attendances Attendance[]
  assignments Assignment[]
}

//assignments model
model Assignment {
  id        String              @id @default(cuid())
  title     String
  subject   Subject
  term      Term                @relation(fields: [termId], references: [id])
  termId    String
  questions Questions[]
  attempts  AssignmentAttempt[]
  endDate   DateTime
}

model Questions {
  id             String           @id @default(cuid())
  name           String
  assignmentId   String
  assignment     Assignment       @relation(fields: [assignmentId], references: [id])
  answers        Answers[]
  studentAnswers StudentAnswers[]
}

model Answers {
  id             String           @id @default(cuid())
  name           String
  isCorrect      Boolean
  question       Questions        @relation(fields: [questionId], references: [id])
  questionId     String
  studentAnswers StudentAnswers[]
}

model AssignmentAttempt {
  id           String           @id @default(cuid())
  userId       String
  assignmentId String
  user         User             @relation(fields: [userId], references: [id])
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  answers      StudentAnswers[]
}

model StudentAnswers {
  id         String            @id @default(cuid())
  attemptId  String
  questionId String
  answerId   String
  attempt    AssignmentAttempt @relation(fields: [attemptId], references: [id])
  question   Questions         @relation(fields: [questionId], references: [id])
  answer     Answers           @relation(fields: [answerId], references: [id])

  @@unique([attemptId, questionId])
}

model AllNotifications {
  id        String   @id @default(cuid())
  title     String
  body      String
  data      Json?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
